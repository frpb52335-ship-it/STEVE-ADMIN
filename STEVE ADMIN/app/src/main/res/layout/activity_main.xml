<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEVE ADMIN"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceOwnerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Checking Device Owner..."
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="#cccccc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE MANAGEMENT"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/blockFactoryResetSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Factory Reset"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/blockNetworkResetSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Network Reset"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/blockWifiConfigSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Wi-Fi Configuration"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/blockBluetoothConfigSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Bluetooth Configuration"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/blockPrivateDnsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Private DNS"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#cccccc" />

        <Button
            android:id="@+id/removeAdminButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove Admin"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
